  "facts": [
    {
      "id": "F01",
      "statement": "Native text/image/video inputs are fused before the text backbone; text output.",
      "locator": "technical-facts.json / facts / 0"
    },
    {
      "id": "F02",
      "statement": "Text hidden size 6144; 60 decoder layers; all 60 use MiniMax Sparse Attention (MSA). Layers 0–2 use dense FFN; layers 3–59 use MoE.",
      "locator": "technical-facts.json / facts / 1"
    },
    {
      "id": "F03",
      "statement": "Pre-normalized decoder: x enters Norm then attention; attention output is added to x. The resulting hidden state enters Norm then FFN/MoE; FFN output is added to the pre-FFN hidden state. Final norm and LM head lie after the decoder stack.",
      "locator": "technical-facts.json / facts / 2"
    },
    {
      "id": "F04",
      "statement": "64 query heads, 4 KV heads, head dimension128: 4 GQA groups, 16 Q heads per group. No attention output gate.",
      "locator": "technical-facts.json / facts / 3"
    },
    {
      "id": "F05",
      "statement": "Indexer has 4 query heads (one/group), width128, and shared index key. Scaled token dot scores are reduced by maximum within each 128-token block; each group selects Top16 blocks, including the local block within the 16-block budget.",
      "locator": "technical-facts.json / facts / 4"
    },
    {
      "id": "F06",
      "statement": "Indexer considers causal j<=i, fully future blocks score minus infinity. Main attention uses exact content QK softmax V on the selected group KV with causal masking within all selected blocks, including the local block. Main K/V are group-specific; shared index K is distinct from main K.",
      "locator": "technical-facts.json / facts / 5"
    },
    {
      "id": "F07",
      "statement": "128 routed experts, Top4, one shared expert. Token data feeds router, selected experts, shared expert. Router computes sigmoid scores; correction bias affects selection only. Selected original unbiased scores are renormalized as mixing weights, and routed sum is scaled by2. Shared expert output is then added; shared does not pass through routed mixing/renorm.",
      "locator": "technical-facts.json / facts / 6"
    },
    {
      "id": "F08",
      "statement": "Router intermediate expert size3072. Only parameter annotations that aid understanding are required.",
      "locator": "technical-facts.json / facts / 7"
    },
    {
      "id": "F09",
      "statement": "DSpark is an auxiliary draft, not extra decoder layers. Omit its internals in this scope.",
      "locator": "technical-facts.json / facts / 8"
    }
  ],
