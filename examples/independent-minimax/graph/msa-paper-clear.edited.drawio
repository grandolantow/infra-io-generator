eometry height="55" width="400" x="160" y="1310" as="geometry"/></mxCell><mxCell id="content_queries" parent="1" role="compute" style="html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#28343D;fontStyle=0;fillColor=#DDECF7;strokeColor=#42647C;strokeWidth=1.8;spacing=8;shape=rectangle;rounded=1;arcSize=7;" value="Main Q&#10;64 Q heads&#10;4 groups ×16 Q&#10;128 per head" vertex="1"><mxGeometry height="120" width="225" x="1040" y="405" as="geometry"/></mxCell><mxCell id="content_kv" parent="1" role="compute" style="html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#28343D;fontStyle=0;fillColor=#DDECF7;strokeColor=#42647C;strokeWidth=1.8;spacing=8;shape=rectangle;rounded=1;arcSize=7;" value="Main K / V&#10;4 group KV heads&#10;128 per head" vertex="1"><mxGeometry height="105" width="250" x="755" y="405" as="geometry"/></mxCell><mxCell id="selected_kv" parent="1" role="compute" style="html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#28343D;fontStyle=0;fillColor=#DDECF7;strokeColor=#42647C;strokeWidth=1.8;spacing=8;shape=rectangle;rounded=1;arcSize=7;" value="Gather group-specific K / V&#10;K_g[S_g(i)], V_g[S_g(i)]" vertex="1"><mxGeometry height="104" width="350" x="755" y="1120" as="geometry"/></mxCell><mxCell id="exact_attention" parent="1" role="compute" style="html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#28343D;fontStyle=0;fillColor=#DDECF7;strokeColor=#42647C;strokeWidth=1.8;spacing=8;shape=rectangle;rounded=1;arcSize=7;" value="Exact content attention&#10;A_g = Softmax(Q_g K_g[S_g]^T /√128 + M)&#10;Output_g = A_g V_g[S_g]&#10;M: causal j ≤ i in all selected blocks,&#10;including the local block" vertex="1"><mxGeometry height="150" width="520" x="750" y="1310" as="geometry"/></mxCell><mxCell id="attn_output_proj" parent="1" role="compute" style="html=0;whiteSpace=wrap;align=cen