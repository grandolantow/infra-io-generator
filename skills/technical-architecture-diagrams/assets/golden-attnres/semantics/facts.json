{
  "id": "attention_residuals_golden",
  "version": {
    "paper": "arXiv:2603.15031v1",
    "paper_url": "https://arxiv.org/pdf/2603.15031v1",
    "official_commit": "85e22310fe5ee860b4a023de312d791de8a5a5e6",
    "readme_blob": "a8cc8834a75d384891481d7d414853cafc1407e9"
  },
  "scope": "Same-token depth mixing; Standard, Full and Block, four illustrative sublayers in two blocks; shared aggregation operator. Not an actual model depth or default block count.",
  "notation": {
    "v0": "embedding = b0 = paper h1",
    "v_l": "raw f_l(h_l), not residual accumulated h_(l+1)",
    "h_l": "input to F_l",
    "b1": "v1+v2",
    "b2": "v3+v4",
    "A_l": "independent learned w_l at each aggregation site",
    "blocks": [
      [
        "F1",
        "F2"
      ],
      [
        "F3",
        "F4"
      ]
    ]
  },
  "required_facts": [
    {
      "id": "G01",
      "statement": "Standard gives every raw output and embedding coefficient 1; identity bypass accumulates the previous residual with current output.",
      "equation": "h_(l+1)=h_l+v_l; h1=v0",
      "source": "paper §2.1 p3"
    },
    {
      "id": "G02",
      "statement": "Full retains separate raw sublayer outputs and embedding for all subsequent aggregation sites.",
      "equation": "h_l=Σ_(i=0)^(l−1) α_(i→l) v_i",
      "source": "paper §3.1 Eq1–4 pp3–4"
    },
    {
      "id": "G03",
      "statement": "Every aggregation site uses its own learned query vector; it is not projected from the current hidden state. Keys make weights content-dependent.",
      "equation": "q_l=w_l",
      "source": "paper Eq3; official forward has separate attention/MLP aggregation parameters"
    },
    {
      "id": "G04",
      "statement": "RMSNorm supplies normalized keys for scoring; values remain the original candidates.",
      "equation": "K=RMSNorm(V); s_j=w_lᵀK_j; α=softmax_candidates(s); h=Σ_j α_jV_j",
      "source": "paper Eq2–4; official block_attn_res"
    },
    {
      "id": "G05",
      "statement": "Weights normalize over depth candidates independently per batch/token, not over sequence positions.",
      "equation": "V:[C,B,T,D], logits/α:[C,B,T], softmax axis C",
      "source": "official einsum and softmax(0)"
    },
    {
      "id": "G06",
      "statement": "A block representation is a unit sum of that block's raw outputs; weighted inputs and embedding do not enter the local sum.",
      "equation": "b_n=Σ_(j∈B_n) f_j(h_j)",
      "source": "paper §3.2 Eq5 p4"
    },
    {
      "id": "G07",
      "statement": "Block-first sublayer attends to embedding and completed prior blocks; later sublayers additionally attend to current partial sum as one candidate.",
      "equation": "V_(n,1)=[b0,…,b_(n−1)]; V_(n,i≥2)=[b0,…,b_(n−1),b_n^(i−1)]",
      "source": "paper §3.2 Eq6 p5"
    },
    {
      "id": "G08",
      "statement": "Embedding stays separate. At block start the empty partial is omitted, not added as a zero candidate.",
      "equation": "b0=v0; no b_n^0 in first branch",
      "source": "paper Eq6; official history includes embedding"
    },
    {
      "id": "G09",
      "statement": "Final readout aggregates all completed block summaries plus separately retained embedding.",
      "equation": "Full:[v0,v1,v2,v3,v4]; Block:[v0,b1,b2]",
      "source": "paper final-output paragraph with Eq6 embedding source; official history list"
    },
    {
      "id": "G10",
      "statement": "The ordinary sublayer transformations remain on the backbone; the change concerns residual mixing, not the sequence-attention mechanism inside F_l.",
      "equation": "v_l=f_l(h_l)",
      "source": "paper §2 notation; official forward applies Norm and Attention/MLP"
    }
  ],
