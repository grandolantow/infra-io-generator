        },
        {
          "source_id": "D/mamba:blog-f712f645e4",
          "role": "method_reference"
        },
        {
          "source_id": "A/densenet:negative-1",
          "role": "counterexample"
        }
      ],
      "user_annotation_ids": [],
      "status": "candidate"
    },
    {
