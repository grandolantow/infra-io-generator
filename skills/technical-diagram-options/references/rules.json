    {
      "id": "S04",
      "name": "逻辑物理映射与存储布局",
      "kind": "structure",
      "structure_modes": [
        "S04"
      ],
      "trigger_features": [
        "mapping",
        "ownership"
      ],
      "required_facts": [
        "logical_objects",
        "physical_locations",
        "mapping"
      ],
      "trigger": "必须解释同一对象在逻辑、物理或缓存表示之间的位置对应。",
      "action": "把逻辑序列、映射表、物理位置作为不同视图；重复对象 ID，而非仅靠颜色连线。保留非连续布局的事实。",
      "alternatives": [
        "S03 布局表适合只有形状",
        "C05 映射加连续状态用于分配变化",
        "S06 拓扑用于跨设备搬运"
      ],
      "boundary": "非连续映射不等于排序变化；分片、压缩、搬运、驱逐是不同操作。",
      "counterexample": "把 PagedAttention 画成直接压缩 token 的漏斗会改变机制；把 MLA latent 和 full KV 当同一个数组会隐藏表示变化。",
      "checks": [
        "逻辑顺序不被物理地址误导",
        "映射基数明确",
        "共享/复制/失效状态有说明",
