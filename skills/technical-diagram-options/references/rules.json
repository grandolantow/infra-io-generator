  "rules": [
    {
      "id": "S01",
      "name": "系统层级与边界",
      "kind": "structure",
      "structure_modes": [
        "S01"
      ],
      "trigger_features": [
        "boundaries",
        "ownership"
      ],
      "required_facts": [
        "entities",
        "containment"
      ],
      "trigger": "读者需要知道组成、层级或责任归属，而非每一步何时发生。",
      "action": "用嵌套边界标出模型/执行/硬件或像素/潜变量/条件域；跨边界连接写明传什么。重复实例可用堆叠或计数，不把堆叠误当顺序。",
      "alternatives": [
        "S02 算子流用于依赖关系",
        "S06 拓扑用于跨设备传输",
        "C02 总览加局部聚焦"
      ],
      "boundary": "架构总览不证明时序、性能或所有实例完全相同。",
      "counterexample": "LDM 三组件博客省去训练 Encoder 与 CFG；不能当完整训练图。DistServe 堆叠只在多实例概览合适。",
      "checks": [
        "每个边界的语义明确",
        "容器关系与数据依赖不混用",
        "跨域对象有身份/单位",
        "Expanded detail inputs/outputs correspond to the exact overview submodule, and the final artifact boundary remains visible."
      ],
      "evidence": [
        {
          "source_id": "A/ldm:paper",
          "role": "method_reference"
        },
        {
          "source_id": "A/ldm:blog-c7dcf10f1d",
          "role": "method_reference"
        },
        {
          "source_id": "D/gshard:paper",
          "role": "method_reference"
        },
        {
          "source_id": "E/tvm:paper",
          "role": "method_reference"
        }
      ],
      "user_annotation_ids": [],
      "status": "candidate"
    },
    {
      "id": "S02",
      "name": "计算数据流与并行汇合",
      "kind": "structure",
      "structure_modes": [
        "S02"
      ],
      "trigger_features": [
        "branch_merge",
        "dependencies"
      ],
      "required_facts": [
        "entities",
        "operations",
        "dependencies"
      ],
      "trigger": "任务重点是输入经过哪些变换、分支如何合并。",
      "action": "以操作和对象为图元；明确 add/concat/multiply/select 的差别。并行分支来自同一输入时对齐，合流处写操作而非无名圆点。",
      "alternatives": [
        "S03 张量图关注形状",
        "S05 时间图关注等待",
        "S10 公式与实例关注算子含义"
      ],
      "boundary": "空间并排只表达结构并行，不自动承诺运行时并发。",
      "counterexample": "DenseNet 的 plus-like concat 草图容易被读成残差加法；不能复制外形后只靠小字纠正。",
      "checks": [
        "每条分支的来源可追踪",
        "合并运算明确",
        "没有把数据边和调度边混成一类",
        "Trace typed inputs: concat is not add; weighted aggregation needs a visible weight edge; residual bypass begins at the correct pre-sublayer state.",
        "Learned/quantization parameters have real sources and dependencies; labels cannot substitute missing input edges.",
        "An add node has the actual required operands; feature, score/weight and control edges are distinguishable.",
        "Enumerate operands of each displayed operation and match them to actual input ports; formulas and nearby labels do not count as edges."
      ],
      "evidence": [
        {
          "source_id": "A/transformer:paper",
          "role": "method_reference"
        },
        {
          "source_id": "A/transformer:blog-4ecc1474ce",
