{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagram-delivery.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "brief_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intent": {
      "type": "string",
      "enum": [
        "model",
        "report",
        "mixed"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "editable_source",
              "rendered",
              "reference",
              "selector",
              "qa",
              "other"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "layout_recipe",
              "experience",
              "golden",
              "public_source"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "reviewed",
              "unavailable"
            ]
          },
          "observations": {
            "type": "string",
            "minLength": 1
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "location",
          "role",
          "status",
          "observations"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "reviewed"
                }
              }
            },
            "then": {
              "required": [
                "artifact_id"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "design": {
      "type": "object",
      "properties": {
        "semantic_summary": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "string",
          "minLength": 1
        },
        "proportions": {
          "type": "string",
          "minLength": 1
        },
        "connections": {
          "type": "string",
          "minLength": 1
        },
        "typography": {
          "type": "string",
          "minLength": 1
        },
        "surrounding_texts": {
          "type": "string",
          "minLength": 1
        },
        "layout_decision": {
          "type": "object"
        },
        "reference_comparison": {
          "type": "string",
          "minLength": 1
        },
        "selector_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "selected_options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "selection_reason": {
          "type": "string",
          "minLength": 1
        },
        "selection_applications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option_id",
              "drawing_object_ids",
              "application"
            ],
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1
              },
              "drawing_object_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "application": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "required": [
        "semantic_summary",
        "components",
        "proportions",
        "connections",
        "typography",
        "surrounding_texts",
        "layout_decision",
        "reference_comparison"
      ],
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "rendered",
            "blocked"
          ]
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "qa_artifact_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "backend",
        "artifact_ids"
      ],
      "additionalProperties": false
    },
    "visual_review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "reviewed",
            "not_run",
            "needs_revision"
          ]
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "observations": {
          "type": "string",
          "minLength": 1
        },
        "reference_comparison": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        }
      },
      "required": [
        "status",
        "artifact_ids",
        "observations",
        "reference_comparison",
        "reviewer"
      ],
      "additionalProperties": false
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "evidence_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "issue",
          "change",
          "evidence_artifact_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "structural_difference",
          "editable_artifact_ids",
          "rendered_artifact_ids",
          "qa_artifact_id",
          "pdf_pages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?=.*[0-9])[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "structural_difference": {
            "type": "string",
            "minLength": 1
          },
          "editable_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "rendered_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "qa_artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "pdf_pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "archive_pdf_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_variant_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "brief_sha256",
    "intent",
    "status",
    "artifacts",
    "references",
    "design",
    "render",
    "visual_review",
    "revisions",
    "limitations"
  ],
  "additionalProperties": false
}
